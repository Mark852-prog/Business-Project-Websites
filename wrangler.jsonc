// Cloudflare Workers config: serves the generated sites in dist/ as static files.
// "wrangler deploy" runs the build command below first, so the dashboard only
// needs the deploy command: npx wrangler deploy
{
  "name": "mark-web",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "node build.js"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
